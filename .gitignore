# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

example

# generated native folders
/ios
/android

# local env — per-machine tokens, never committed
.env*.local

# Isolated concurrent streams — one branch, one worktree, one window.
.worktrees/

# Worktree wiring: __tests__ reaches armillary-core's event schema by a relative
# path that, from a worktree, lands here rather than at the armillary root.
# Gitignored — machine wiring, not content. See scripts/worktree.sh.
/repos/
